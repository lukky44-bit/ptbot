{
  "id": null,
  "uid": "k6-live-overview",
  "title": "k6 Live Overview",
  "tags": ["k6", "prometheus", "live"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "5s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "test_run_id",
        "label": "Test Run ID",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values({__name__=~\"k6_.*\"}, test_run_id)",
        "refresh": 2,
        "sort": 3,
        "multi": false,
        "includeAll": true,
        "current": {
          "selected": true,
          "text": "All",
          "value": ".*"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "k6_checks_rate",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 0 },
      "datasource": "Prometheus",
      "targets": [
        { "refId": "A", "expr": "avg(k6_checks_rate{test_run_id=~\"$test_run_id\"})", "legendFormat": "avg" }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "k6_data_received_total",
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 0 },
      "datasource": "Prometheus",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(k6_data_received_total{test_run_id=~\"$test_run_id\"}[1m]))",
          "legendFormat": "sum(rate)"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "k6_data_sent_total",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 },
